{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SAISlideTake",
  "version": "0.1.0",
  "identifier": "com.sai.slidetake",
  "build": {
    "devUrl": "http://localhost:1425",
    "frontendDist": "../../9.output/web"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost tauri: asset: https: http: ws: wss:; connect-src 'self' ipc: http://ipc.localhost tauri: https: http: ws: wss:; img-src 'self' asset: http://asset.localhost data: https: http: blob:; style-src 'self' 'unsafe-inline' https: http:; font-src 'self' data: https: http:; media-src 'self' blob: http: https:;"
    },
    "windows": [
      {
        "label": "main",
        "title": "SAISlideTake",
        "width": 360,
        "height": 56,
        "minWidth": 360,
        "minHeight": 56,
        "maxWidth": 420,
        "maxHeight": 480,
        "resizable": false,
        "decorations": false,
        "shadow": true,
        "transparent": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "visible": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist"
    }
  }
}
